# Copy to .env.local for `vercel dev`. Never commit real keys.
# Set ONE AI key. Groq and Gemini have free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: groq | gemini | anthropic (default: first key found, in that order)
ASK_PROVIDER=
# Optional: override the provider's default model
ASK_MODEL=
ALLOWED_ORIGINS=
